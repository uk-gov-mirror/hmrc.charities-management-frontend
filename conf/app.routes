# microservice specific routes

->         /hmrc-frontend                            hmrcfrontend.Routes


GET        /                                         controllers.HomeController.landingPage

GET        /start                                    controllers.StartController.start

GET        /keep-alive                               controllers.StartController.keepAlive

GET        /service-timeout                          controllers.StartController.timedOut

GET        /manage-charity-repayment-claim           controllers.CharitiesRepaymentDashboardController.onPageLoad

GET        /there-is-a-problem-access-denied         controllers.AccessDeniedController.onPageLoad

GET        /assets/*file                             controllers.Assets.versioned(path="/public", file: Asset)
